    def admit_numpy(
        self, coefficients: NDArray[np.float64]
    ) -> FormElement[Variance, Degree]: ...
    def realize_integral(self, exact: object) -> FormElement[Variance, Degree]: ...
    def identity(self) -> FormOperator[Variance, Degree, Variance, Degree]: ...
    def zero_to[TargetVariance: str, TargetDegree: int](
        self, target: FormSpace[TargetVariance, TargetDegree]
    ) -> FormOperator[Variance, Degree, TargetVariance, TargetDegree]: ...
