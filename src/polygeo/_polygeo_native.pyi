class Element[SpaceType: Space[Any, Any, int]]:
    _proof: SpaceType
    @property
    def degree(self) -> int: ...
    @property
    def dimension(self) -> int: ...
    def to_python_copy(self) -> tuple[tuple[int, ...], tuple[ExactScalar, ...]]: ...
    def evaluate[Scalar: ExactScalar, Degree: int](
        self: Element[Space[Scalar, Cochain, Degree]],
        chain: Element[Space[Scalar, Chain, Degree]],
    ) -> Scalar: ...
    def cup[Scalar: ExactScalar](
        self: Element[Space[Scalar, Cochain, int]],
        other: Element[Space[Scalar, Cochain, int]],
    ) -> Element[Space[Scalar, Cochain, int]]: ...
    def wedge(
        self: Element[Space[Fraction, Cochain, int]],
        other: Element[Space[Fraction, Cochain, int]],
    ) -> Element[Space[Fraction, Cochain, int]]: ...

class LinearMap[SourceSpace: Space[Any, Any, int], TargetSpace: Space[Any, Any, int]]:
    @property
    def source(self) -> SourceSpace: ...
    @property
    def target(self) -> TargetSpace: ...
    def apply(self, value: Element[SourceSpace]) -> Element[TargetSpace]: ...
    @overload
    def dual[Scalar: ExactScalar, SourceDegree: int, TargetDegree: int](
        self: LinearMap[
            Space[Scalar, Chain, SourceDegree],
            Space[Scalar, Chain, TargetDegree],
        ],
    ) -> LinearMap[
        Space[Scalar, Cochain, TargetDegree],
        Space[Scalar, Cochain, SourceDegree],
    ]: ...
    @overload
    def dual[Scalar: ExactScalar, SourceDegree: int, TargetDegree: int](
        self: LinearMap[
            Space[Scalar, Cochain, SourceDegree],
            Space[Scalar, Cochain, TargetDegree],
        ],
    ) -> LinearMap[
        Space[Scalar, Chain, TargetDegree],
        Space[Scalar, Chain, SourceDegree],
    ]: ...
    def compose[
        Initial: Space[Any, Any, int],
        Middle: Space[Any, Any, int],
        Final: Space[Any, Any, int],
    ](
        self: LinearMap[Middle, Final], before: LinearMap[Initial, Middle]
    ) -> LinearMap[Initial, Final]: ...
    def over[SourceVariance, TargetVariance, SourceDegree: int, TargetDegree: int](
        self: LinearMap[
            Space[int, SourceVariance, SourceDegree],
            Space[int, TargetVariance, TargetDegree],
        ],
        coefficients: RationalField,
    ) -> LinearMap[
        Space[Fraction, SourceVariance, SourceDegree],
        Space[Fraction, TargetVariance, TargetDegree],
    ]: ...

class ChainComplex[Scalar: ExactScalar]:
