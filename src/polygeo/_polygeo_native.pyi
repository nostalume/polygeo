class Csr[
    SourceSpace: Space[Any, Any, int],
    TargetSpace: Space[Any, Any, int],
    Encoding,
]:
    represented_map: LinearMap[SourceSpace, TargetSpace]
    encoding: type[Encoding]
    @staticmethod
    def estimate[
        Source: Space[Any, Any, int],
        Target: Space[Any, Any, int],
        EncodingType,
    ](map_: LinearMap[Source, Target], encoding: type[EncodingType]) -> CsrEstimate: ...
    @classmethod
    @overload
    def build[Source: Space[Any, Any, int], Target: Space[Any, Any, int]](
        cls,
        map_: LinearMap[Source, Target],
        encoding: type[BigIntEncoding],
        limit: CsrBuildLimit,
    ) -> Csr[Source, Target, BigIntEncoding]: ...
    @classmethod
    @overload
    def build[Source: Space[Any, Any, int], Target: Space[Any, Any, int]](
        cls,
        map_: LinearMap[Source, Target],
        encoding: type[ReducedFractionEncoding],
        limit: CsrBuildLimit,
    ) -> Csr[Source, Target, ReducedFractionEncoding]: ...
    def apply(self, value: Element[SourceSpace]) -> Element[TargetSpace]: ...
    @overload
    def to_python_copy(
        self: Csr[SourceSpace, TargetSpace, BigIntEncoding],
    ) -> IntegerCsrParts: ...
    @overload
    def to_python_copy(
        self: Csr[SourceSpace, TargetSpace, ReducedFractionEncoding],
    ) -> RationalCsrParts: ...
    def to_scipy_int64_copy(
        self: Csr[SourceSpace, TargetSpace, BigIntEncoding],
    ) -> csr_array: ...

