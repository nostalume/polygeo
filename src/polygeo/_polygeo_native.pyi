    ) -> FormElement[Literal["cochain"], int]: ...

class FormOperator[
    SourceVariance: str,
    SourceDegree: int,
    TargetVariance: str,
    TargetDegree: int,
]:
    def __new__(cls, _token: Never, /) -> Self: ...
    @property
    def source(self) -> FormSpace[SourceVariance, SourceDegree]: ...
    @property
    def target(self) -> FormSpace[TargetVariance, TargetDegree]: ...
    @property
    def execution_steps(self) -> int: ...
    def same_identity(self, other: FormOperator[Any, Any, Any, Any]) -> bool: ...
    def apply(
        self, value: FormElement[SourceVariance, SourceDegree]
    ) -> FormElement[TargetVariance, TargetDegree]: ...
    def compose[BeforeVariance: str, BeforeDegree: int](
        self,
        before: FormOperator[
            BeforeVariance, BeforeDegree, SourceVariance, SourceDegree
        ],
    ) -> FormOperator[BeforeVariance, BeforeDegree, TargetVariance, TargetDegree]: ...
    def dirichlet(
        self,
        rhs: FormElement[TargetVariance, TargetDegree],
        prescribed: FormElement[TargetVariance, TargetDegree],
    ) -> Problem[DirichletResult]: ...

type FormChainSpace[Degree: int] = FormSpace[Literal["chain"], Degree]
type FormCochainSpace[Degree: int] = FormSpace[Literal["cochain"], Degree]
type FormChain[Degree: int] = FormElement[Literal["chain"], Degree]
type FormCochain[Degree: int] = FormElement[Literal["cochain"], Degree]

