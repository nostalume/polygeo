class FormSpace[Variance: str, Degree: int]:
    def __new__(cls, _token: Never, /) -> Self: ...
    @property
    def degree(self) -> Degree: ...
    @property
    def size(self) -> int: ...
    @property
    def variance(self) -> Variance: ...
    @property
    def is_full(self) -> bool: ...
