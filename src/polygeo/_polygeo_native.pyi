    ) -> LinearMap[Space[Scalar, Chain, int], Space[Scalar, Chain, int]]: ...
    def over(
        self: ChainComplex[int], coefficients: RationalField
    ) -> ChainComplex[Fraction]: ...

class CochainComplex[Scalar: ExactScalar]:
