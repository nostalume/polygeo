    def same_owner(self, other: ChainComplex[Any]) -> bool: ...
    def __getitem__[Degree: int](
        self, degree: Degree
    ) -> Space[Scalar, Chain, Degree]: ...
    def dual(self) -> CochainComplex[Scalar]: ...
    def boundary(
        self, degree: int
    ) -> LinearMap[Space[Scalar, Chain, int], Space[Scalar, Chain, int]]: ...
    def over(
        self: ChainComplex[int], coefficients: RationalField
    ) -> ChainComplex[Fraction]: ...

class CochainComplex[Scalar: ExactScalar]:
